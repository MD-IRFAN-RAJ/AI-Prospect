# Backend environment variables for buyhatke backend
# Copy this file to `.env` and fill in values when using Supabase or Gemini

# Server
PORT=4000

# CORS origin for frontend (vite)
CORS_ORIGIN=http://localhost:5173

# Optional: Google Generative AI / Gemini API key
# Obtain from Google Cloud and set here to enable real AI responses
GEMINI_API_KEY=

# Optional: Tavily API key for live web search
TAVILY_API_KEY=

# Optional: Supabase configuration. If set, search history and companies will be persisted.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
